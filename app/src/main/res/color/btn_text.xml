<?xml version="1.0" encoding="utf-8"?>
<!-- button text: dimmed when the button is disabled, so it no longer looks tappable -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#66FFFFFF" />
    <item android:color="@color/white" />
</selector>
