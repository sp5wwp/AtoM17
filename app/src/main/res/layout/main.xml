<?xml version="1.0" encoding="utf-8"?>
<!-- AtoM17 main screen: header, FM / M17 and VFO / MEM switches, the frequency, the tabs and their panels.
     Options live in SettingsActivity (gear). Touch targets are 48 dp, the Start / Stop pill 44 dp (the header is 48). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp">

    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/logo" android:contentDescription="@string/m17" />
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingLeft="8dp" android:textColor="@color/text3" android:textSize="11.5sp" android:maxLines="2" />
        <ImageButton android:id="@+id/power" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_power"
            android:background="@drawable/row_bg" android:contentDescription="@string/main_power_desc" />
        <!-- the 24 dp icon sits 12 dp inside its 48 dp button: pull it out by that much so its edge lines up with the widgets below -->
        <ImageButton android:id="@+id/gear" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_gear"
            android:layout_marginRight="-12dp" android:background="@drawable/row_bg" android:contentDescription="@string/main_gear_desc" />
    </LinearLayout>

    <!-- transmit power, mode and VFO / MEM: three toggles of one kind, the label (or the power icon) is the state -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/powerBtn" android:layout_width="56dp" android:layout_height="48dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/toggle" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/powerIcon" android:layout_width="26dp" android:layout_height="16dp" android:src="@drawable/ic_txpower_lo"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/powerText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="@color/white" android:textStyle="bold" android:textSize="10sp" android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView android:id="@+id/modeBtn" android:layout_width="0dp" android:layout_weight="1.37" android:layout_height="48dp"
            android:layout_marginLeft="8dp" android:background="@drawable/toggle" android:gravity="center"
            android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/memBtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:layout_marginLeft="8dp" android:background="@drawable/toggle" android:gravity="center"
            android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout android:id="@+id/freqHolder" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/card" android:paddingLeft="4dp" android:paddingRight="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingLeft="4dp">
        <View android:id="@+id/sigBar" android:layout_width="3dp" android:layout_height="14dp" />
        <TextView android:id="@+id/sigText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingLeft="8dp" android:textColor="@color/text3" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@drawable/seg_bg" android:padding="3dp">
        <TextView android:id="@+id/tabLive" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:gravity="center" android:textStyle="bold" android:textSize="14sp" android:text="@string/main_tablive" />
        <TextView android:id="@+id/tabHeard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:gravity="center" android:textStyle="bold" android:textSize="14sp" android:text="@string/main_tabheard" />
        <LinearLayout android:id="@+id/tabInbox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tabInboxText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="14sp" android:text="@string/main_tabinboxtext" />
            <TextView android:id="@+id/inboxBadge" android:layout_width="wrap_content" android:layout_height="18dp" android:minWidth="18dp"
                android:layout_marginLeft="6dp" android:background="@drawable/badge" android:gravity="center" android:paddingLeft="5dp" android:paddingRight="5dp"
                android:textColor="@color/on_orange" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp">
        <ScrollView android:id="@+id/panelLive" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/liveBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <LinearLayout android:id="@+id/panelHeard" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/heardList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/card" />
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:gravity="right">
                <Button android:id="@+id/heardClear" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="88dp" android:minHeight="0dp"
                    android:background="@drawable/btn" android:textColor="@color/white" android:textStyle="bold" android:textAllCaps="false" android:text="@string/main_heardclear" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/panelInbox" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/inboxList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp">
                <Button android:id="@+id/smsNew" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:minHeight="0dp" android:background="@drawable/btn_primary"
                    android:textColor="@color/on_orange" android:textStyle="bold" android:textAllCaps="false" android:text="@string/main_smsnew" />
                <Button android:id="@+id/smsClear" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="88dp" android:minHeight="0dp"
                    android:layout_marginLeft="8dp" android:background="@drawable/btn" android:textColor="@color/white" android:textStyle="bold"
                    android:textAllCaps="false" android:text="@string/main_heardclear" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/txBar" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" android:gravity="center" android:textStyle="bold" android:textSize="15sp"
        android:background="@drawable/card" android:textColor="@color/text2" android:text="@string/main_txbar" />
</LinearLayout>
