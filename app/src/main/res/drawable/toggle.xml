<?xml version="1.0" encoding="utf-8"?>
<!-- The main screen's toggles (transmit power, mode, VFO / MEM): the frequency card's fill and edge (1 dp), lighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="14dp" /><solid android:color="#33FFFFFF" /><stroke android:width="1dp" android:color="#29FFFFFF" /></shape></item>
    <item><shape><corners android:radius="14dp" /><solid android:color="#1CFFFFFF" /><stroke android:width="1dp" android:color="#29FFFFFF" /></shape></item>
</selector>
