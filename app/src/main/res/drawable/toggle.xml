<?xml version="1.0" encoding="utf-8"?>
<!-- The main screen's toggles (transmit power, mode, VFO / MEM): the cards' light fill, no edge, lighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="14dp" /><solid android:color="#33FFFFFF" /></shape></item>
    <item><shape><corners android:radius="14dp" /><solid android:color="#1CFFFFFF" /></shape></item>
</selector>
